# ============================================================================
# MedLab Diagnostics — Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Fill in your actual secrets and database credentials below.
# 3. NEVER commit the actual '.env' file to Git or version control!
# ============================================================================

# ── Application Security & Cryptographic Signing ─────────────────────────────
# Generate a cryptographically secure 64-character secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_hex_string_64_chars_long

# Set to 1 only during local development. Set to 0 in grading/production.
FLASK_DEBUG=1

# Cookie Security: Set to 1 when running over HTTPS (enables Secure flag and HSTS).
# Leave as 0 when running locally over plain HTTP (http://127.0.0.1:5000).
COOKIE_SECURE=0


# ── MySQL Database Connection ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medlab_db

# LEAST-PRIVILEGE BEST PRACTICE (Graded University Requirement):
# - During development setup: use root credentials.
# - For runtime app operation: use the dedicated 'medlab_app' user created by
#   running 'database/db_security.sql' in MySQL Workbench.
DB_USER=medlab_app
DB_PASSWORD=MedLab_App_Pass#2026!


# ── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_FOLDER=static/uploads/avatars
MAX_CONTENT_LENGTH=2097152


# ── Supabase Authentication (OTP / Magic Links / Google OAuth) ───────────────
# Obtain these from your Supabase Project Settings -> API.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here


# ── Database Rebuild Safety Guardrail ────────────────────────────────────────
# build_db.py will refuse to DROP and recreate the database without explicit
# authorization. Set to YES only when performing an automated, clean database reset.
ALLOW_DB_RESET=NO
